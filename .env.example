# ── 계정 ────────────────────────────────────────────────────
# 코레일 (KTX/SRT 통합). 지금은 이쪽을 쓰세요.
# 아이디: 회원번호 / 이메일 / 휴대폰번호 중 아무거나
KORAIL_ID=
KORAIL_PW=

# 코레일 앱 버전. 비워두면 내장 후보를 자동으로 시도합니다.
# "버전이 낮다"는 응답이 계속 나오면 여기에 실제 앱 버전을 넣으세요.
KORAIL_VERSION=

# SRT 레거시 경로 (통합 이후 예매가 막혔습니다. 조회 실험용)
SRT_ID=
SRT_PW=

# ── 텔레그램 알림 ───────────────────────────────────────────
# @BotFather 에서 봇을 만들고 받은 토큰
TELEGRAM_TOKEN=
# 봇에게 아무 메시지나 보낸 뒤:
#   python -m railcatch telegram-chatid
TELEGRAM_CHAT_ID=

# ── 동작 설정 ───────────────────────────────────────────────
# 조회 간격(초). 2초 미만은 강제로 2초로 올라갑니다.
POLL_INTERVAL=3
WEB_HOST=127.0.0.1
WEB_PORT=8777
DATA_DIR=data
