# ── 계정 (쓰는 사업자만 채우면 됩니다) ──────────────────────
# SRT: 회원번호 / 이메일 / 휴대폰번호 중 아무거나
SRT_ID=
SRT_PW=

# 코레일: 회원번호 / 이메일 / 휴대폰번호 중 아무거나
KORAIL_ID=
KORAIL_PW=

# ── 텔레그램 알림 ───────────────────────────────────────────
# @BotFather 에서 봇을 만들고 받은 토큰
TELEGRAM_TOKEN=
# 봇에게 아무 메시지나 보낸 뒤:
#   python -m railcatch telegram-chatid
TELEGRAM_CHAT_ID=

# ── 동작 설정 ───────────────────────────────────────────────
# 조회 간격(초). 2초 미만은 강제로 2초로 올라갑니다.
POLL_INTERVAL=3
WEB_HOST=127.0.0.1
WEB_PORT=8777
DATA_DIR=data
